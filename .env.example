# Copiar para .env e preencher. O .env está no .gitignore — nunca commitar.

# ── Scraper (Python / psycopg) ──────────────────────────────────────────────
# Connection string do Session pooler do Supabase (Connect -> Connection String -> Session pooler).
# Se a password tiver caracteres especiais (@, #, ...), têm de ficar URL-encoded (@ -> %40).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# ── API (Java / Spring Boot) ─────────────────────────────────────────────────
# CORS: origens permitidas (separadas por vírgula). Por omissão: http://localhost:5173.
# Em produção, colocar o domínio do Vercel: https://jobify.vercel.app
# CORS_ALLOWED_ORIGINS=https://jobify.vercel.app
# Mesma ligação, mas em formato JDBC. Localmente pode ser a ligação direta;
# em produção usar o session pooler (porta 5432, nunca o transaction pooler 6543).
DB_URL=jdbc:postgresql://aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=PASSWORD
